# =====================================================================
# HUB Monitoramento - configuracao de uma loja
# Copie para .env e ajuste. NUNCA versione o .env real.
# =====================================================================

STORE_NAME=LOJA MODELO

# ------------------------- AGENTE (PDV) ------------------------------
# Endereços reservados para documentação; substitua após levantamento autorizado.
MACHINE_NAME=CAIXA02

SERVER_URL=https://192.0.2.10:8443
SERVER_IP=192.0.2.10
SERVER_CA_FILE=certs/server-ca.pem
AGENT_INGEST_TOKEN=
ALLOW_INSECURE_HTTP=false
GATEWAY_IP=192.0.2.1

# Destino fiscal (a UF e o documento definem o que sera testado)
FISCAL_UF=SP
FISCAL_DOCUMENT=nfce
FISCAL_ENDPOINT_CONFIRMED=false
SEFAZ_HOST=nfce.fazenda.sp.gov.br
SEFAZ_PORT=443

INTERNET_TARGETS=1.1.1.1,8.8.8.8
EXTERNAL_DNS_SERVERS=1.1.1.1,8.8.8.8

INTERVAL_GATEWAY=2
INTERVAL_SERVER=2
INTERVAL_INTERNET=3
INTERVAL_DNS=10
INTERVAL_SEFAZ_TCP=5
INTERVAL_SEFAZ_TLS=15
# TEF (opcional; desligado por padrao)
INTERVAL_TEF=3
TEF_WATCH_PORTS=55845
TEF_LEARNING_MODE=false

SEFAZ_AUTHORIZATION_LOG_PATH=

# Confirmacao por TCP quando o ICMP esta bloqueado
PING_TIMEOUT_MS=1000
TCP_TIMEOUT=5

# Arquivo de conexao da loja (.hubconn importado). Vazio = usa SERVER_URL.
CONNECTION_FILE=
ALLOW_HTTP_CONNECTION=false

SNAPSHOT_INTERVAL=5
SENDER_INTERVAL=5
QUEUE_MAX_ROWS=200000

HEALTH_HOST=127.0.0.1
HEALTH_PORT=8010
LOG_LEVEL=INFO
DATA_DIR=
LOG_DIR=

# ------------------------ SERVIDOR CENTRAL ---------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SERVER_ALLOW_HTTP=false
SERVER_TLS_CERT_FILE=server/certs/server.pem
SERVER_TLS_KEY_FILE=server/certs/server-key.pem
LOCAL_SUBNET=192.0.2.0/24

DB_PATH=
DASHBOARD_TITLE=HUB - SAÚDE OPERACIONAL DA LOJA
RETENTION_DAYS=90

INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_RECOVERY_THRESHOLD=3
INCIDENT_AGGREGATION_WINDOW=30

# Use um grupo por loja com a HUB e os contatos autorizados pelo cliente.
# Sem as credenciais, não há alertas nem resumo para a operação.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_SUMMARY=true
TELEGRAM_DAILY_SUMMARY_HOUR=7

# MikroTik - usuario SOMENTE LEITURA, restrito ao IP do servidor
MIKROTIK_ENABLED=false
MIKROTIK_HOST=192.0.2.1
MIKROTIK_PORT=8728
MIKROTIK_USER=monitor-readonly
MIKROTIK_PASSWORD=
MIKROTIK_USE_SSL=false
MIKROTIK_POLL_INTERVAL=15

# Netwatch: nomes dos hosts na RB que representam cada WAN
MIKROTIK_WAN1_NAME=WAN-1
MIKROTIK_WAN2_NAME=WAN-2
MIKROTIK_WAN3_NAME=WAN-3

# Gateways reais da RB, necessarios para identificar a rota WAN ativa.
# Informe os valores observados na tabela de rotas; sem correspondencia unica, sera desconhecida.
MIKROTIK_WAN_GATEWAYS=WAN-1=192.0.2.1,WAN-2=198.51.100.1,WAN-3=203.0.113.1
